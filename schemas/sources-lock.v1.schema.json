{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hq.example/schemas/sources-lock.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lockId", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "lockId": { "type": "string", "pattern": "^lock:[a-f0-9]{64}$" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "repositoryUrl",
          "defaultBranch",
          "resolvedCommitSha",
          "manifestPath",
          "marketplaceDialect",
          "sourceManifestDigest",
          "retrievedAt",
          "synchronizationStatus",
          "pluginPins"
        ],
        "properties": {
          "sourceId": { "type": "string" },
          "repositoryUrl": { "type": "string", "format": "uri" },
          "defaultBranch": { "type": "string" },
          "resolvedCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "manifestPath": { "type": "string" },
          "marketplaceDialect": { "type": "string" },
          "sourceManifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "synchronizationStatus": { "type": "string" },
          "pluginPins": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pluginName",
                "repositoryUrl",
                "pluginSubdirectory",
                "resolvedCommitSha"
              ],
              "properties": {
                "pluginName": { "type": "string", "minLength": 1 },
                "repositoryUrl": { "type": "string", "format": "uri" },
                "pluginSubdirectory": { "type": "string" },
                "resolvedCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
              }
            }
          }
        }
      }
    }
  }
}
