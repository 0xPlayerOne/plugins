{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hq.example/schemas/compatibility.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "type": "string", "pattern": "^catalog:[a-f0-9]{64}$" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pluginId", "harnessCompatibility"],
        "properties": {
          "pluginId": { "type": "string" },
          "harnessCompatibility": { "type": "object" }
        }
      }
    }
  }
}
