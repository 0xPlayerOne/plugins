{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hq.example/schemas/catalog.v1.schema.json",
  "title": "Agent HQ Plugin Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "generatedAt", "sources", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "type": "string", "pattern": "^catalog:[a-f0-9]{64}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "plugins": { "type": "array", "items": { "$ref": "#/$defs/plugin" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "displayName",
        "repositoryUrl",
        "marketplaceDialect",
        "manifestPath",
        "defaultBranch",
        "resolvedCommitSha",
        "retrievalTimestamp",
        "trustClassification",
        "sourceManifestDigest",
        "synchronizationStatus"
      ],
      "properties": {
        "sourceId": { "type": "string" },
        "displayName": { "type": "string" },
        "repositoryUrl": { "type": "string", "format": "uri" },
        "marketplaceDialect": { "enum": ["openai", "cursor", "claude"] },
        "manifestPath": { "type": "string" },
        "defaultBranch": { "type": "string" },
        "resolvedCommitSha": { "$ref": "#/$defs/sha" },
        "retrievalTimestamp": { "type": "string", "format": "date-time" },
        "trustClassification": { "const": "official" },
        "sourceManifestDigest": { "$ref": "#/$defs/digest" },
        "synchronizationStatus": { "enum": ["synchronized", "unchanged", "failed"] }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "paths", "metadata", "securityImpact"],
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object" },
        "securityImpact": { "enum": ["none", "review", "sensitive"] }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons", "responsibleCapabilities"],
      "properties": {
        "status": { "type": "string" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "responsibleCapabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "resolvedRepositoryUrl",
        "resolvedCommitSha",
        "pluginSubdirectory",
        "canonicalContentDigest",
        "manifestDigest",
        "contentResolution",
        "releaseMetadata",
        "capabilities",
        "requiredConnectors",
        "requiredCredentials",
        "permissionSensitiveChanges",
        "fileIndex",
        "publicationTimestamp"
      ],
      "properties": {
        "releaseId": { "type": "string", "pattern": "^release:[a-f0-9]{64}$" },
        "upstreamVersion": { "type": "string" },
        "resolvedRepositoryUrl": { "type": "string", "format": "uri" },
        "resolvedCommitSha": { "$ref": "#/$defs/sha" },
        "pluginSubdirectory": { "type": "string" },
        "canonicalContentDigest": { "$ref": "#/$defs/digest" },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "contentResolution": { "enum": ["complete", "metadata-only"] },
        "releaseMetadata": { "type": "object" },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "requiredConnectors": { "type": "array", "items": { "type": "string" } },
        "requiredCredentials": { "type": "array", "items": { "type": "string" } },
        "permissionSensitiveChanges": { "type": "array", "items": { "type": "string" } },
        "fileIndex": { "type": "array", "items": { "type": "string" } },
        "publicationTimestamp": { "type": "string", "format": "date-time" }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "displayName",
        "description",
        "productGroupingKey",
        "categories",
        "keywords",
        "authors",
        "icons",
        "sourceId",
        "upstreamPluginName",
        "currentReleaseId",
        "availableReleases",
        "capabilitySummary",
        "harnessCompatibility",
        "license",
        "provenance",
        "securityClassification"
      ],
      "properties": {
        "pluginId": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "productGroupingKey": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "authors": { "type": "array", "items": { "type": "string" } },
        "homepage": { "type": "string", "format": "uri" },
        "icons": { "type": "array", "items": { "type": "string" } },
        "sourceId": { "type": "string" },
        "upstreamPluginName": { "type": "string" },
        "currentReleaseId": { "type": "string" },
        "availableReleases": { "type": "array", "items": { "$ref": "#/$defs/release" } },
        "capabilitySummary": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "harnessCompatibility": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/compatibility" }
        },
        "license": { "type": "object" },
        "provenance": { "type": "object" },
        "securityClassification": { "type": "object" }
      }
    }
  }
}
